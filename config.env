# TTS 配置
TTS_ENGINE=edge
TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1/chat/completions
TTS_API_KEY=
TTS_VOICE=云希
TTS_STYLE=用平静温和的语气简要汇报

# 插件状态（MODE_PERSIST=true 时无需手动 /enable，chat 模式持久化保存）
MODE_PERSIST=false
CHAT_MODE=false

# 智能总结配置 (可选，默认使用 Google Gemini 免费模型)
SUMMARY_ENABLED=true
SUMMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
SUMMARY_API_KEY=
SUMMARY_MODEL=gemini-flash-lite-latest
